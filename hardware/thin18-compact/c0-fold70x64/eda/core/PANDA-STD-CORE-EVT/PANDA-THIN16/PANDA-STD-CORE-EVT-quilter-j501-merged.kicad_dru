(version 1)

(rule "J201 GCT USB4105 vendor internal locating-hole clearance"
	(constraint hole_clearance (min 0.19mm))
	(condition "A.memberOfFootprint('J201') && B.memberOfFootprint('J201')")
)

(rule "U503 official LGA internal pad clearance candidate"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U503') && B.memberOfFootprint('U503')")
)

(rule "U405 TI YFP0004 internal ball-land clearance candidate"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U405') && B.memberOfFootprint('U405')")
)

(rule "U402 TI YFP0004 internal ball-land clearance candidate"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U402') && B.memberOfFootprint('U402')")
)

(rule "U403 TI YFP0004 internal ball-land clearance candidate"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U403') && B.memberOfFootprint('U403')")
)

(rule "U404 TI YFP0004 internal ball-land clearance candidate"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U404') && B.memberOfFootprint('U404')")
)

(rule "U301 TI YZF0009 central VSS / B1 BIN escape clearance candidate"
	(constraint clearance (min 0.15mm))
	(condition "(A.memberOfFootprint('U301') && A.Type == 'Pad' && B.Type == 'Track' && B.NetName == 'GND') || (B.memberOfFootprint('U301') && B.Type == 'Pad' && A.Type == 'Track' && A.NetName == 'GND')")
)

(rule "J503 TC2030 contact-pad other-net clearance"
	(constraint clearance (min 0.508mm))
	(condition "(A.memberOfFootprint('J503') && A.Type == 'Pad' && A.NetName != '' && !B.memberOfFootprint('J503') && B.NetName != A.NetName) || (B.memberOfFootprint('J503') && B.Type == 'Pad' && B.NetName != '' && !A.memberOfFootprint('J503') && A.NetName != B.NetName)")
)

(rule "J201 USB4500 manufacturer edge-ending SMT lands"
 (constraint edge_clearance (min 0mm))
 (condition "A.memberOfFootprint('J201') && A.Type == 'Pad' && A.Pad_Type == 'SMD'")
)

(rule "J802 pad-to-track 0.15 mm escape exception"
	(constraint clearance (min 0.15mm))
	(condition "(A.memberOfFootprint('J802') && A.Type == 'Pad' && B.Type == 'Track') || (B.memberOfFootprint('J802') && B.Type == 'Pad' && A.Type == 'Track')")
)

(rule "J201 pad-to-track 0.15 mm escape exception"
	(constraint clearance (min 0.15mm))
	(condition "(A.memberOfFootprint('J201') && A.Type == 'Pad' && B.Type == 'Track') || (B.memberOfFootprint('J201') && B.Type == 'Pad' && A.Type == 'Track')")
)

(rule "J501 pad-to-track 0.15 mm escape exception"
	(constraint clearance (min 0.15mm))
	(condition "(A.memberOfFootprint('J501') && A.Type == 'Pad' && B.Type == 'Track') || (B.memberOfFootprint('J501') && B.Type == 'Pad' && A.Type == 'Track')")
)

(rule "U501 pad-to-track 0.15 mm escape exception"
	(constraint clearance (min 0.15mm))
	(condition "(A.memberOfFootprint('U501') && A.Type == 'Pad' && B.Type == 'Track') || (B.memberOfFootprint('U501') && B.Type == 'Pad' && A.Type == 'Track')")
)
